    <script>
        (function initTheme(){
            var currentTheme = localStorage.getItem('theme') || 'light';
            document.body.setAttribute('data-theme', currentTheme);
            window.toggleTheme = function() {
                var theme = document.body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.body.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
            };
        })();
        const globalTransactionsSortState = {};
        function sortGlobalTransactions(field) {
            const tbody = document.getElementById('globalTransactionsBody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            const dir = globalTransactionsSortState[field] === 'asc' ? 'desc' : 'asc';
            globalTransactionsSortState[field] = dir;

            function getColIndex(field) {
                if (field === 'id') return 0;
                if (field === 'date') return 1;
                if (field === 'subject') return 2;
                if (field === 'item') return 3;
                if (field === 'details') return 4;
                if (field === 'amount') return 5;
                if (field === 'balance') return 6;
                return 0;
            }
            const idx = getColIndex(field);

            function getVal(row, idx, field) {
                const tds = row.querySelectorAll('td');
                const td = tds[idx];
                if (!td) return '';
                if (field === 'id') {
                    const badge = td.querySelector('.badge');
                    return badge ? badge.textContent.trim() : td.textContent.trim();
                }
                if (field === 'amount' || field === 'balance') {
                    return parseFloat(td.textContent.replace(/[^\d\.\-]/g, '')) || 0;
                }
                if (field === 'date') {
                    const txt = td.textContent.trim();
                    const d = new Date(txt);
                    return isNaN(d.getTime()) ? txt : d.getTime();
                }
                return td.textContent.trim().toLowerCase();
            }

            rows.sort((a, b) => {
                const av = getVal(a, idx, field);
                const bv = getVal(b, idx, field);
                if (typeof av === 'number' && typeof bv === 'number') {
                    return dir === 'asc' ? av - bv : bv - av;
                }
                if (typeof av === 'string' && typeof bv === 'string') {
                    return dir === 'asc' ? av.localeCompare(bv, 'ar', { sensitivity: 'base' }) : bv.localeCompare(av, 'ar', { sensitivity: 'base' });
                }
                return dir === 'asc' ? av - bv : bv - av;
            });
            rows.forEach(r => tbody.appendChild(r));

            ['id','date','subject','item','details','amount','balance'].forEach(f => {
                const th = document.getElementById('th-' + f);
                const icon = document.getElementById('sortIcon-' + f);
                if (th && icon) {
                    th.classList.remove('active');
                    icon.className = 'fa-solid fa-sort sort-icon';
                }
            });
            const currentTh = document.getElementById('th-' + field);
            const currentIcon = document.getElementById('sortIcon-' + field);
            if (currentTh && currentIcon) {
                currentTh.classList.add('active');
                currentIcon.className = dir === 'asc' ? 'fa-solid fa-sort-up sort-icon' : 'fa-solid fa-sort-down sort-icon';
            }
        }

        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const btn = content.previousElementSibling;
            
            if (content.classList.contains('active')) {
                content.classList.remove('active');
                if(btn) btn.classList.remove('active');
            } else {
                // Close others
                document.querySelectorAll('.accordion-content').forEach(c => c.classList.remove('active'));
                document.querySelectorAll('.accordion-btn').forEach(b => b.classList.remove('active'));
                
                content.classList.add('active');
                if(btn) btn.classList.add('active');
            }
        }

        function toggleDetails(id) {
            var el = document.getElementById(id);
            var icon = document.getElementById('icon-' + id);
            if (el.style.display === "none") {
                el.style.display = "block";
                if(icon) icon.style.transform = "rotate(90deg)";
            } else {
                el.style.display = "none";
                if(icon) icon.style.transform = "rotate(0deg)";
            }
        }
        
        const membersList = <%- JSON.stringify(membersList || []) %>;
        
        // Custom Dropdown Logic
        const recipientInput = document.getElementById('recipient_name_input');
        const customDropdown = document.getElementById('custom-members-dropdown');
        const codeInput = document.getElementById('target_member_code');
        const dropdownItems = document.querySelectorAll('.custom-dropdown-item');

        if (recipientInput && customDropdown && codeInput) {
            // Show dropdown on focus
            recipientInput.addEventListener('focus', function() {
                filterDropdown(this.value);
            });

            // Hide dropdown on click outside (handled by blur with delay)
            recipientInput.addEventListener('blur', function() {
                setTimeout(() => {
                    customDropdown.style.display = 'none';
                }, 200);
            });

            // Filter on input
            recipientInput.addEventListener('input', function() {
                const val = this.value;
                filterDropdown(val);
                
                // Also update hidden code if exact match typed manually
                const found = membersList.find(m => m && m.name === val);
                codeInput.value = found ? found.member_code : '';
            });

            // Handle item selection
            dropdownItems.forEach(item => {
                item.addEventListener('click', function() {
                    const name = this.getAttribute('data-name');
                    const code = this.getAttribute('data-code');
                    
                    recipientInput.value = name;
                    codeInput.value = code;
                    customDropdown.style.display = 'none';
                });
            });

            function filterDropdown(query) {
                const val = query.toLowerCase();
                let hasVisible = false;
                dropdownItems.forEach(item => {
                    const name = item.getAttribute('data-name').toLowerCase();
                    if (name.includes(val)) {
                        item.style.display = 'block';
                        hasVisible = true;
                    } else {
                        item.style.display = 'none';
                    }
                });
                customDropdown.style.display = hasVisible ? 'block' : 'none';
            }
        }
        const toggleRecipientBtn = document.getElementById('toggleRecipientBtn');
        const recipientSection = document.getElementById('recipientSection');
        if (toggleRecipientBtn && recipientSection) {
            toggleRecipientBtn.addEventListener('click', function() {
                const isHidden = recipientSection.style.display === 'none' || recipientSection.style.display === '';
                recipientSection.style.display = isHidden ? 'block' : 'none';
            });
        }
        const toggleNewContributionBtn = document.getElementById('toggleNewContributionBtn');
        const newContributionSection = document.getElementById('newContributionSection');
        if (toggleNewContributionBtn && newContributionSection) {
            toggleNewContributionBtn.addEventListener('click', function() {
                const isHidden = newContributionSection.style.display === 'none' || newContributionSection.style.display === '';
                newContributionSection.style.display = isHidden ? 'block' : 'none';
            });
        }
    </script>
    
    <script>
    const chatHeader = document.getElementById('chat-header');
    const chatMessages = document.getElementById('chat-messages');
    const input = document.getElementById('input');
    const sendBtn = document.getElementById('send');
    const typing = document.getElementById('typing');
    const chatExport = document.getElementById('chat-export');
    const pdfSave = document.getElementById('pdfSave');
    const imgSave = document.getElementById('imgSave');
    const headerIco = document.getElementById('headerIco');
    const icon = document.getElementById("headerInd");
    
    let conversation_id= '';
    let instructions = true;
    let getAnswer = false;
    
    chatHeader.addEventListener('click', () => {
      const display = window.getComputedStyle(chatMessages).display;
      chatMessages.style.display = display === 'none' ? 'block' : 'none';
      document.getElementById('chat-input').style.display = display === 'none' ? 'flex' : 'none';
    
      if(chatMessages.style.display==='none') {
        icon.classList.remove("fa-chevron-down");
        icon.classList.add("fa-chevron-up");
        if (getAnswer == false && chatMessages.children.length > 0)  {
          headerIco.style.visibility = "visible";
        }
        typing.style.display = 'none';
        showExport = false;
        showChatExport();
      } else {
        icon.classList.remove("fa-chevron-up");
        icon.classList.add("fa-chevron-down");
        headerIco.style.visibility = "hidden";
        if (getAnswer == false && chatMessages.children.length > 0)  {
          typing.style.display = 'block';
        }
      }
      scrollToBottom();
    });
    
    function scrollToBottom() {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    
    let totalSeconds = 0;
    let interval = null;
    const timerDiv = document.getElementById("timer");
    
    async function sendMessage() {
    
      sendBtn.disabled = true;
      
      if (interval !== null) {
        clearInterval(interval);
        totalSeconds=0;
        timerDiv.textContent= "00:00"
      }
    
      interval = setInterval(() => {
        totalSeconds++;
    
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
    
        timerDiv.textContent = String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
      }, 1000);
    
      const msg = input.value.trim();
      if (!msg) return;
    
      if(instructions) {
        const instr = document.createElement('div');
        instr.innerHTML = "<sup>- إضغط مرتين على سؤالك لنسخه وتعديله</sup>";
        instr.innerHTML = instr.innerHTML + "<br>" + "<sup>- إضغط مرتين على الرد لحفظ المحادثة</sup>";
        instr.innerHTML = instr.innerHTML + "<br>" + "<sup>- إضغط على السؤال المقترح وبعدها ارسال</sup>";
        instr.style.textAlign = "right";
        instr.style.background = 'azure';
        chatMessages.appendChild(instr);
        instructions= false;
      }
    
      if(showExport==false) {
        showChatExport();
      }
      
      const userBubble = document.createElement('div');
      userBubble.classList.add('message', 'user');
      userBubble.textContent = msg;
      chatMessages.appendChild(userBubble);
    
      userBubble.addEventListener('dblclick', () => {
          if(getAnswer)
            input.value= userBubble.textContent;
      });
      
      input.value = '';
      const intervalId = setInterval(() => {
        scrollToBottom();
        clearInterval(intervalId);
      }, 10);
    
      typing.style.display = 'block';
      input.disabled = true;
      pdfSave.disabled = true;
      imgSave.disabled = true;
    
      try {
        getAnswer = false;
        const response = await fetch('/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg, conversationId: conversation_id})
        });
    
        const data = await response.json();
        typing.style.display = 'none';
    
        conversation_id= data.reply.conversation_id;
    
        const botBubble = document.createElement('div');
        botBubble.style= "overflow: visible;"
        botBubble.classList.add('message', 'bot');
        botBubble.addEventListener('dblclick', showChatExport);
        if(data.reply.content !== undefined)
          if(data.reply.content.length > 0)
            botBubble.innerHTML = data.reply.content[0].replaceAll('\n', '<br>').replace(/\*\*(.*?)\*\*/g, '<b>$1</b>') + '<br>';
        if(data.reply.table !== undefined) {
          const accArea = document.createElement('div'); 
          accArea.innerHTML = `
            <div class="accordion-gpt">
              <div class="accordion-item-gpt">
                <div class="accordion-header-gpt">عرض البيانات كجدول</div>
                <div class="accordion-content-gpt">
                  <div class="accordion-inner-gpt">
                    ${renderTable(data.reply.table)}
                  </div>
                </div>
              </div>
            </div>
          `;
          botBubble.appendChild(accArea);
          const headers = accArea.querySelectorAll(".accordion-header-gpt");
    
          headers.forEach(header => {
          header.addEventListener("click", () => {
            const content = header.nextElementSibling;
            const isOpen = header.classList.contains("active");
    
            headers.forEach(h => {
              h.classList.remove("active");
              h.nextElementSibling.style.maxHeight = null;
            });
    
            if (!isOpen) {
              header.classList.add("active");
              content.style.maxHeight = "none";
              const height = content.scrollHeight;
              content.style.maxHeight = height + "px";
            }
            });
          });
        }
        if (data.reply.contentQues !== undefined) {
          const quesDiv = document.createElement("div");
          quesDiv.innerHTML = data.reply.contentQues;
          botBubble.appendChild(quesDiv);
        }
        chatMessages.appendChild(botBubble);
        
        if(data.reply.suggestedQuestions !== undefined) {
          const questionsArea = document.createElement('questionsArea');
          questionsArea.innerHTML = "<b>" + "أسئلة مقترحة" + "</b>"
          const questions = data.reply.suggestedQuestions;
          questions.forEach(q => {
            const btn = document.createElement("button");
            btn.textContent = '- ' + q;
            btn.onclick = () => {
            if (!input.disabled) {
              input.value = btn.textContent.replace("- ", "");
              }
            };
            btn.style= "font-size: 16px;"
            btn.style.color = '#FF4500';
            btn.style.background = 'none';
            btn.style.border = 'none';
            btn.style.padding = '0';
            btn.style.cursor = 'pointer';
            btn.style.display = "flex";
            btn.style.flexDirection = "column";
            btn.style.gap = "10px";
            btn.style.textAlign = "right",
            btn.style.width="100%",
            questionsArea.appendChild(btn);
          });
          chatMessages.appendChild(questionsArea)
        }
    
        if(data.reply.created_timestamp !== undefined) {
          const time = document.createElement('div');
          time.style.direction = 'ltr';
          time.innerHTML = '<sub>' + data.reply.created_timestamp.replace('AM','ص').replace('PM','م'); + '</sub>';
          chatMessages.appendChild(time);
        }
    
        const spacesArea = document.createElement('spacesArea');
        spacesArea.innerHTML="<br>"
        chatMessages.appendChild(spacesArea)
    
        scrollToBottom();
        headerIco.style.visibility = "hidden";
        chatHeader.style.backgroundColor="green";
    
        setTimeout(() => {
          chatHeader.style.backgroundColor="#4A90E2";
        }, 3000);
    
      } catch (error) {
        typing.style.display = 'none';
        const errorBubble = document.createElement('div');
        errorBubble.classList.add('message', 'bot');
        errorBubble.textContent = "نرجو التأكد من إتصالك بالإنترنت عدا ذلك قم بإبلاغ القائمين على الموقع بحدوث مشكله";
        errorBubble.style.color = 'red';
        errorBubble.style.textAlign = "center";
        chatMessages.appendChild(errorBubble);
        const spacesArea = document.createElement('spacesArea');
        spacesArea.innerHTML="<br>"
        chatMessages.appendChild(spacesArea)
        scrollToBottom();
      }
      input.disabled = false;
      pdfSave.disabled = false;
      imgSave.disabled = false;
      sendBtn.disabled = false;
      getAnswer = true;
    }
    
    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keypress', e => { if (e.key === 'Enter') sendMessage(); });
    
    showExport = true;
    function showChatExport() {
      if(chatMessages.children.length > 0 && typing.style.display === 'none') {
        if(showExport) 
          chatExport.style.display = 'block';
        else
          chatExport.style.display = 'none';
        showExport= !showExport;
      }
      //scrollToBottom();
    }
    
    function renderTable(table) {
      
      const columns = table.manifest.schema.columns;
    
      let html = '';
    
      if(table?.result?.data_array) {
    
        table.result.data_array.forEach(row => {
          html += `
            <table border='0'style='width: 100%;table-layout: fixed; border-collapse: separate;
      border-spacing: 0;
      border-radius: 8px;
      overflow: hidden;'>`;
    
          columns.forEach((col, index) => {
            if (row[index] !== null) {
              html += `
                <tr style='text-align:right;'>
                  <td style='background:#d8d6d6;'>
                    ${col.name.replace('_', ' ').toUpperCase()}
                  </td>
                  <td td style='background:#e3e2e2;'>
                    ${row[index]}
                  </td>
                </tr>
              `;
            }
          });
    
        html += `
          </table><br>
        `;});
      } else {
        html += `
            <table border='0'style='width: 100%;table-layout: fixed;'>
              <tr><td style="background:#e5e3e3">لا توجد بيانات</td></tr></table>
          `;
      }
      return html;
    }
    
    function saveImage() {
    
      const widget = document.getElementById("chat-widget");
      const messages = document.getElementById("chat-messages");
    
      // Save original styles
      const original = {
        widgetMaxHeight: widget.style.maxHeight,
        widgetOverflow: widget.style.overflow,
        messagesHeight: messages.style.height,
        messagesOverflow: messages.style.overflow
      };
    
      // Remove parent constraints
      widget.style.maxHeight = "none";
      widget.style.overflow = "visible";
    
      // Expand messages
      messages.style.height = messages.scrollHeight + "px";
      messages.style.overflow = "visible";
    
      html2canvas(widget, {
        scale: 2,
        useCORS: true
      }).then(canvas => {
    
        // Restore original styles
        widget.style.maxHeight = original.widgetMaxHeight;
        widget.style.overflow = original.widgetOverflow;
        messages.style.height = original.messagesHeight;
        messages.style.overflow = original.messagesOverflow;
    
        // Download image
        const link = document.createElement("a");
        link.download = "jam3ya-gpt-img.png";
        link.href = canvas.toDataURL("image/png");
        link.click();
    
      }).catch(err => {
        //console.error("Capture failed:", err);
    
        // Restore styles on error
        widget.style.maxHeight = original.widgetMaxHeight;
        widget.style.overflow = original.widgetOverflow;
        messages.style.height = original.messagesHeight;
        messages.style.overflow = original.messagesOverflow;
      });
      const intervalId = setInterval(() => {
        scrollToBottom();
        clearInterval(intervalId);
      }, 100);
    }
    
    function savePDF() {
    
      const widget = document.getElementById("chat-widget");
      const messages = document.getElementById("chat-messages");
    
      const original = {
        widgetMaxHeight: widget.style.maxHeight,
        widgetOverflow: widget.style.overflow,
        messagesHeight: messages.style.height,
        messagesOverflow: messages.style.overflow
      };
    
      widget.style.maxHeight = "none";
      widget.style.overflow = "visible";
      messages.style.height = messages.scrollHeight + "px";
      messages.style.overflow = "visible";
    
      html2canvas(widget, {
        scale: 2,
        useCORS: true
      }).then(canvas => {
    
        // Restore styles
        widget.style.maxHeight = original.widgetMaxHeight;
        widget.style.overflow = original.widgetOverflow;
        messages.style.height = original.messagesHeight;
        messages.style.overflow = original.messagesOverflow;
    
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF("p", "mm", "a4");
    
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
    
        const imgWidth = pageWidth * 0.25;     // 🔹 smaller
        const xOffset = (pageWidth - imgWidth) / 2; // center
    
        const imgHeight = canvas.height * imgWidth / canvas.width;
    
        let heightLeft = imgHeight;
        let position = 0;
    
        const imgData = canvas.toDataURL("image/png");
    
        pdf.addImage(imgData, "PNG", xOffset, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;
    
        while (heightLeft > 0) {
          position = heightLeft - imgHeight;
          pdf.addPage();
          pdf.addImage(imgData, "PNG", xOffset, position, imgWidth, imgHeight);
          heightLeft -= pageHeight;
        }
    
        pdf.save("jam3ya-gpt-pdf.pdf");
      });
      const intervalId = setInterval(() => {
        scrollToBottom();
        clearInterval(intervalId);
      }, 100);
    }
</script>
</body>
</html>
