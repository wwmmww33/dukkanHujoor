        function renderLinkedTransactionResults(filterText) {
            var resultsBox = document.getElementById('auctionLinkedTransactionResults');
            var q = (filterText || '').trim().toLowerCase();
            var matches = linkedTransactionOptions.filter(function(o) {
                return !q || o.label.toLowerCase().indexOf(q) !== -1;
            }).slice(0, 30);

            var html = '<div class="searchable-result-item clear-link" data-id="">-- بدون ربط --</div>';
            if (matches.length === 0) {
                html += '<div class="searchable-result-item muted">لا توجد نتائج</div>';
            } else {
                html += matches.map(function(o) {
                    return '<div class="searchable-result-item" data-id="' + o.id + '">' + o.label + '</div>';
                }).join('');
            }
            resultsBox.innerHTML = html;
            resultsBox.style.display = 'block';
        }

        document.addEventListener('DOMContentLoaded', function() {
            var searchInput = document.getElementById('auctionLinkedTransactionSearch');
            var resultsBox = document.getElementById('auctionLinkedTransactionResults');
            if (!searchInput || !resultsBox) return;

            searchInput.addEventListener('input', function(e) { renderLinkedTransactionResults(e.target.value); });
            searchInput.addEventListener('focus', function(e) { renderLinkedTransactionResults(e.target.value); });

            resultsBox.addEventListener('click', function(e) {
                var item = e.target.closest('.searchable-result-item');
                if (!item) return;
                var id = item.getAttribute('data-id');
                if (!id) {
                    setAuctionLinkedTransactionDisplay('');
                } else {
                    var chosen = linkedTransactionOptions.find(function(o) { return String(o.id) === id; });
                    if (chosen) {
                        document.getElementById('auctionLinkedTransaction').value = chosen.id;
                        searchInput.value = chosen.label;
                        if (chosen.details) document.getElementById('auctionDescription').value = chosen.details;
                    }
                }
                resultsBox.style.display = 'none';
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('#auctionLinkedTransactionWrapper')) {
                    resultsBox.style.display = 'none';
                }
            });

            var editBtns = document.querySelectorAll('.edit-auction-btn');
            editBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    editAuction(JSON.parse(btn.getAttribute('data-auction')));
                });
            });

            var viewBidsBtns = document.querySelectorAll('.view-bids-btn');
            viewBidsBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    viewAuctionBids(btn.getAttribute('data-id'), btn.getAttribute('data-status'), btn.getAttribute('data-title'), btn.getAttribute('data-description'));
                });
            });
        });

        function cancelAuction(id) {
            if (!confirm('هل أنت متأكد من إلغاء هذه المزايدة؟')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/jam3ya/auctions/cancel';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function endAuctionNow(id) {
            if (!confirm('هل أنت متأكد من إنهاء هذه المزايدة الآن؟')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/jam3ya/auctions/end-now';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function reopenAuction(id) {
            if (!confirm('هل أنت متأكد من إعادة فتح هذه المزايدة؟ سيتم إلغاء الترسية الحالية.')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/jam3ya/auctions/reopen';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function deleteAuction(id) {
            if (!confirm('هل أنت متأكد من حذف هذه المزايدة نهائياً؟ سيتم حذف كل العروض المرتبطة بها.')) return;
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/jam3ya/auctions/delete';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function viewAuctionBids(auctionId, auctionStatus, auctionTitle, auctionDescription) {
            document.getElementById('auctionBidsTitle').innerText = 'عروض المزايدة: ' + auctionTitle;
            document.getElementById('auctionBidsBody').innerHTML = '<tr><td colspan="4">جاري التحميل...</td></tr>';
            document.getElementById('auctionBidsModal').style.display = 'flex';

            fetch('/jam3ya/auctions/' + auctionId + '/bids')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.bids || data.bids.length === 0) {
                        document.getElementById('auctionBidsBody').innerHTML = '<tr><td colspan="4">لا توجد عروض بعد</td></tr>';
                        return;
                    }
                    const canAward = (auctionStatus === 'published' || auctionStatus === 'ended');
                    const escapeAttr = function(s) {
                        return String(s == null ? '' : s)
                            .replace(/&/g, '&amp;')
                            .replace(/"/g, '&quot;')
                            .replace(/</g, '&lt;')
                            .replace(/>/g, '&gt;');
                    };
                    document.getElementById('auctionBidsBody').innerHTML = data.bids.map(function(b) {
                        const awardBtn = canAward
                            ? '<button type="button" class="btn btn-success award-bid-btn" data-auction-id="' + auctionId + '" data-bid-id="' + b.id + '" data-title="' + escapeAttr(auctionTitle) + '" data-description="' + escapeAttr(auctionDescription) + '">ترسية</button>'
                            : '-';
                        return '<tr><td>' + b.member_name + ' (' + b.member_code + ')</td><td>' + (b.member_phone || '-') + '</td><td>' + Number(b.amount).toFixed(3) + '</td><td>' + awardBtn + '</td></tr>';
                    }).join('');
                    document.querySelectorAll('.award-bid-btn').forEach(function(btn) {
                        btn.addEventListener('click', function() {
                            awardAuction(btn.getAttribute('data-auction-id'), btn.getAttribute('data-bid-id'), btn.getAttribute('data-title'), btn.getAttribute('data-description'));
                        });
                    });
                })
                .catch(() => {
                    document.getElementById('auctionBidsBody').innerHTML = '<tr><td colspan="4">حدث خطأ في التحميل</td></tr>';
                });
        }

        function awardAuction(auctionId, bidId, auctionTitle, auctionDescription) {
            if (!confirm('هل أنت متأكد من ترسية المزايدة على هذا العرض؟')) return;
            fetch('/jam3ya/auctions/' + auctionId + '/award', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ winning_bid_id: bidId })
            })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) { alert(data.message || 'فشل حفظ الترسية'); return; }
                    document.getElementById('auctionBidsModal').style.display = 'none';
                    openAuctionSaleTransaction(data.amount, data.auction_title || auctionTitle, data.auction_description || auctionDescription, data.member_code);
                })
                .catch(() => alert('حدث خطأ في النظام'));
        }

        function openAuctionSaleTransaction(amount, auctionTitle, auctionDescription, memberCode) {
            showAddTransactionModal();
            const incomeRadio = document.getElementById('type_income');
            const expenseRadio = document.getElementById('type_expense');
            if (incomeRadio) incomeRadio.checked = true;
            if (expenseRadio) expenseRadio.checked = false;

            const subjectSelect = document.getElementById('transaction_subject');
            if (subjectSelect) {
                let hasSaleSubject = false;
                for (let i = 0; i < subjectSelect.options.length; i++) {
                    if (subjectSelect.options[i].value === 'بيع') { hasSaleSubject = true; break; }
                }
                if (!hasSaleSubject) {
                    const opt = document.createElement('option');
                    opt.value = 'بيع';
                    opt.text = 'بيع';
                    subjectSelect.appendChild(opt);
                }
                subjectSelect.value = 'بيع';
            }

            toggleTransactionFields();

            const descInput = document.getElementById('transaction_description');
            if (descInput) descInput.value = auctionTitle;

            const amountInput = document.querySelector('#addTransactionModal input[name="amount"]');
            const detailsInput = document.querySelector('#addTransactionModal textarea[name="details"]');
            if (amountInput) amountInput.value = amount;
            if (detailsInput) {
                let text = 'بيع بالمزايدة: ' + auctionTitle;
                if (auctionDescription) text += ' - ' + auctionDescription;
                text += ' | رقم العضو الفائز: ' + memberCode;
                detailsInput.value = text;
            }
        }

        function toggleTransactionFields() {
            const subjectSelect = document.getElementById('transaction_subject');
            const selectedOption = subjectSelect.options[subjectSelect.selectedIndex];
            const subject = selectedOption.value;
            const subjectType = selectedOption.getAttribute('data-type') || 'expense';

            // Auto-set income/expense radio based on subject type
            if (subjectType === 'income') {
                document.getElementById('type_income').checked = true;
            } else {
                document.getElementById('type_expense').checked = true;
            }

            const memberField = document.getElementById('member_field');
            const descField = document.getElementById('description_field');
            const memberInput = document.getElementById('transaction_member');
            const descInput = document.getElementById('transaction_description');

            // Target specific inputs in the Add Modal
            const amountInput = document.querySelector('#addTransactionModal input[name="amount"]');
            const detailsInput = document.querySelector('#addTransactionModal textarea[name="details"]');

            // Check if subject is "مساهمات الاعضاء" (Member Contributions)
            if (subject === 'مساهمات الاعضاء') {
                memberField.style.display = 'block';
                descField.style.display = 'none';
                memberInput.required = true;
                descInput.required = false;
                if (!memberInput.value) descInput.value = ''; // Clear description only if empty

                // Set default values
                amountInput.value = 12;
                detailsInput.value = new Date().getFullYear();
            } else {
                memberField.style.display = 'none';
                descField.style.display = 'block';
                memberInput.required = false;
                descInput.required = true;
                memberInput.value = ''; // Clear member if switching to description

                // Clear defaults if they match the auto-set ones
                if (amountInput.value == 12) amountInput.value = '';
                if (detailsInput.value == new Date().getFullYear()) detailsInput.value = '';
            }
        }

        function toggleEditTransactionFields() {
            const subjectSelect = document.getElementById('edit_transaction_subject');
            const selectedOption = subjectSelect.options[subjectSelect.selectedIndex];
            const subject = selectedOption.value;
            const subjectType = selectedOption.getAttribute('data-type') || 'expense';

            // Auto-set income/expense radio based on subject type
            if (subjectType === 'income') {
                document.getElementById('edit_type_income').checked = true;
            } else {
                document.getElementById('edit_type_expense').checked = true;
            }

            const memberField = document.getElementById('edit_member_field');
            const descField = document.getElementById('edit_description_field');
            const memberInput = document.getElementById('edit_transaction_member');
            const descInput = document.getElementById('edit_transaction_description');

            if (subject === 'مساهمات الاعضاء') {
                memberField.style.display = 'block';
                descField.style.display = 'none';
                memberInput.required = true;
                descInput.required = false;
            } else {
                memberField.style.display = 'none';
                descField.style.display = 'block';
                memberInput.required = false;
                descInput.required = true;
            }
        }

        function editTransaction(t) {
            document.getElementById('editTransactionModal').style.display = 'flex';
            
            // Set ID
            document.getElementById('edit_id').value = t.id;
            
            // Set Type
            if (t.amount >= 0) {
                document.getElementById('edit_type_income').checked = true;
            } else {
                document.getElementById('edit_type_expense').checked = true;
            }
            
            // Set Date
            if (t.date) {
                document.getElementById('edit_date').value = t.date.split('T')[0];
            }
            
            // Set Amount
            document.getElementById('edit_amount').value = Math.abs(t.amount);
            
            // Set Details
            document.getElementById('edit_details').value = t.details || '';
            
            // Set Subject
            const subjectSelect = document.getElementById('edit_transaction_subject');
            subjectSelect.value = t.subject;
            
            // Handle Item (Member vs Description)
            // We use the isMember flag we computed in the server
            const memberInput = document.getElementById('edit_transaction_member');
            const descInput = document.getElementById('edit_transaction_description');
            
            // Trigger toggle to set visibility based on subject
            toggleEditTransactionFields();
            
            if (t.isMember) {
                // Find member ID from code (t.item is code)
                const member = membersList.find(m => m.member_code === t.item);
                if (member) {
                    memberInput.value = member.id;
                }
            } else {
                descInput.value = t.item;
            }
        }
    </script>

    <!-- Add Transaction Modal -->
    <div id="addTransactionModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>تسجيل عملية مالية</h3>
                <span class="close" onclick="closeModal('addTransactionModal')">&times;</span>
            </div>
            <form action="/jam3ya/transactions/add" method="POST">
                <div class="form-group">
                    <label>نوع العملية:</label>
                    <div class="checkbox-group">
                        <input type="radio" name="type" value="income" id="type_income" checked>
                        <label for="type_income">وارد (مدخول / مساهمة)</label>
                        <input type="radio" name="type" value="expense" id="type_expense">
                        <label for="type_expense">صادر (مصروف / تسليم)</label>
                    </div>
                </div>

                <div class="form-group">
                    <label>التاريخ:</label>
                    <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>

                <div class="form-group">
                    <label>ربط العملية بالتزام (اختياري):</label>
                    <select name="obligation_id" id="obligation_id">
                        <option value="">-- بدون ربط --</option>
                        <% if (obligations && obligations.length > 0) { %>
                            <% obligations.forEach(o => { 
                                   if (Number(o.remaining_amount || 0) <= 0) return;
                                   const rawDesc = o.description || '';
                                   const lines = rawDesc.split('\n');
                                   const baseDesc = (lines[0] || '').trim();
                                   const notesLine = lines.find(l => l.trim().startsWith('ملاحظات:')) || '';
                                   const notesText = notesLine.replace(/^ملاحظات:\s*/,'').trim();
                                   const displayDesc = [baseDesc, notesText].filter(Boolean).join(' | ');
                                   const shortDesc = displayDesc.length > 40 ? (displayDesc.substring(0, 40) + '...') : displayDesc;
                            %>
                                <option 
                                    value="<%= o.id %>" 
                                    data-subject="<%= o.subject %>" 
                                data-description="<%= baseDesc %>" 
                                data-notes="<%= notesText %>">
                                    <%= o.subject %>
                                    <% if (shortDesc) { %> - البند: <%= shortDesc %><% } %>
                                    - المتبقي: <%= o.remaining_amount.toFixed(3) %>
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label>الموضوع / التصنيف:</label>
                    
                    <!-- Quick Select Buttons -->
                    <div id="quick-subjects" style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 10px;">
                        <% if (typeof activeSubjects !== 'undefined' && activeSubjects.length > 0) { %>
                            <% activeSubjects.forEach(sub => { %>
                                <button type="button" class="btn btn-outline" data-type="<%= sub.type %>" onclick="selectSubject('<%= sub.name %>', '<%= sub.type %>')"><%= sub.name %></button>
                            <% }) %>
                        <% } %>
                        <button type="button" class="btn btn-primary" onclick="showSubjectDropdown()">عرض الكل...</button>
                    </div>

                    <select name="subject" id="transaction_subject" required onchange="toggleTransactionFields()" style="<%= (typeof activeSubjects !== 'undefined' && activeSubjects.length > 0) ? 'display: none;' : '' %>">
                        <option value="">-- اختر الموضوع --</option>
                        <% subjects.forEach(s => { %>
                            <option value="<%= s.name %>" data-type="<%= s.type || 'expense' %>"><%= s.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="member_field">
                    <label>العضو:</label>
                    <select name="member_id" id="transaction_member">
                        <option value="">-- اختر العضو --</option>
                        <% members.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.member_code %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="description_field" style="display: none;">
                    <label>الموضوع الفرعي (البند):</label>
                    <input type="text" name="description" id="transaction_description" placeholder="مثال: فاتورة كهرباء شهر 5">
                </div>

                <div class="form-group">
                    <label>المبلغ (ر.ع):</label>
                    <input type="number" step="0.001" name="amount" required placeholder="0.000">
                </div>

                <div class="form-group">
                    <label>التفاصيل (ملاحظات):</label>
                    <textarea name="details" placeholder="ملاحظات إضافية (اختياري)"></textarea>
                </div>

                <button type="submit" class="btn btn-success" style="width: 100%">حفظ العملية</button>
            </form>
        </div>
    </div>

    <!-- Edit Transaction Modal -->
    <div id="editTransactionModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>تعديل عملية مالية</h3>
                <span class="close" onclick="closeModal('editTransactionModal')">&times;</span>
            </div>
            <form action="/jam3ya/transactions/edit" method="POST">
                <input type="hidden" name="id" id="edit_id">
                
                <div class="form-group">
                    <label>نوع العملية:</label>
                    <div class="checkbox-group">
                        <input type="radio" name="type" value="income" id="edit_type_income">
                        <label for="edit_type_income">وارد (مدخول / مساهمة)</label>
                        <input type="radio" name="type" value="expense" id="edit_type_expense">
                        <label for="edit_type_expense">صادر (مصروف / تسليم)</label>
                    </div>
                </div>

                <div class="form-group">
                    <label>التاريخ:</label>
                    <input type="date" name="date" id="edit_date" required>
                </div>

                <div class="form-group">
                    <label>الموضوع / التصنيف:</label>
                    <select name="subject" id="edit_transaction_subject" required onchange="toggleEditTransactionFields()">
                        <% subjects.forEach(s => { %>
                            <option value="<%= s.name %>" data-type="<%= s.type || 'expense' %>"><%= s.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="edit_member_field">
                    <label>العضو:</label>
                    <select name="member_id" id="edit_transaction_member">
                        <option value="">-- اختر العضو --</option>
                        <% members.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.member_code %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group" id="edit_description_field" style="display: none;">
                    <label>الموضوع الفرعي (البند):</label>
                    <input type="text" name="description" id="edit_transaction_description" placeholder="مثال: فاتورة كهرباء شهر 5">
                </div>

                <div class="form-group">
                    <label>المبلغ (ر.ع):</label>
                    <input type="number" step="0.001" name="amount" id="edit_amount" required placeholder="0.000">
                </div>

                <div class="form-group">
                    <label>التفاصيل (ملاحظات):</label>
                    <textarea name="details" id="edit_details" placeholder="ملاحظات إضافية (اختياري)"></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%">حفظ التعديلات</button>
            </form>
        </div>
    </div>
    <div id="auctionModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="auctionModalTitle">إضافة مزايدة</h3>
                <span class="close" onclick="closeModal('auctionModal')">&times;</span>
            </div>
            <form action="/jam3ya/auctions/save" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="id" id="auctionId">
                <div class="form-group">
                    <label>ربط بسجل شراء سابق (اختياري):</label>
                    <div id="auctionLinkedTransactionWrapper" style="position:relative;">
                        <input type="text" id="auctionLinkedTransactionSearch" placeholder="بحث بالتاريخ أو الموضوع أو البند..." autocomplete="off">
                        <input type="hidden" name="linked_transaction_id" id="auctionLinkedTransaction">
                        <div id="auctionLinkedTransactionResults" class="searchable-results"></div>
                    </div>
                </div>
                <div class="form-group">
                    <label>اسم المادة:</label>
                    <input type="text" name="title" id="auctionTitle" required>
                </div>
                <div class="form-group">
                    <label>الوصف:</label>
                    <textarea name="description" id="auctionDescription" placeholder="وصف المادة (اختياري)"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>السعر الابتدائي (ر.ع):</label>
                        <input type="number" step="0.001" name="starting_price" id="auctionStartingPrice" required>
                    </div>
                    <div class="form-group">
                        <label>الحد الأدنى للزيادة (ر.ع):</label>
                        <input type="number" step="0.001" name="min_increment" id="auctionMinIncrement" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>الكمية (اختياري):</label>
                        <input type="number" step="0.001" name="quantity" id="auctionQuantity">
                    </div>
                    <div class="form-group">
                        <label>الوحدة (اختياري):</label>
                        <input type="text" name="unit" id="auctionUnit" placeholder="مثال: كجم، قطعة">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>تاريخ البداية:</label>
                        <input type="datetime-local" name="start_date" id="auctionStartDate" required>
                    </div>
                    <div class="form-group">
                        <label>تاريخ النهاية:</label>
                        <input type="datetime-local" name="end_date" id="auctionEndDate" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>حالة المزايدة:</label>
                    <select name="status" id="auctionStatus">
                        <option value="draft">مسودة</option>
                        <option value="published">منشورة</option>
                        <option value="cancelled">ملغاة</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>صورة المادة:</label>
                    <div id="auctionImagePreview" style="display:none; margin-bottom:10px;">
                        <img id="auctionImagePreviewImg" src="" alt="الصورة الحالية" style="max-width:150px; max-height:150px; border-radius:8px; display:block; margin-bottom:6px;">
                        <small>رفع صورة جديدة أدناه سيستبدل هذه الصورة</small>
                    </div>
                    <input type="file" name="auction_image" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%">حفظ المزايدة</button>
            </form>
        </div>
    </div>

    <div id="auctionBidsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="auctionBidsTitle">عروض المزايدة</h3>
                <span class="close" onclick="closeModal('auctionBidsModal')">&times;</span>
            </div>
            <div class="table-container">
            <table class="table-fit auction-bids-table">
                <thead>
                    <tr>
                        <th>العضو</th>
                        <th>الهاتف</th>
                        <th>المبلغ</th>
                        <th>ترسية</th>
                    </tr>
                </thead>
                <tbody id="auctionBidsBody">
                    <tr><td colspan="4">جاري التحميل...</td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <style>
        @media (max-width: 768px) {
            .hide-on-mobile {
                display: none;
            }
        }
        .searchable-results {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            z-index: 50;
            background: var(--surface, #fff);
            border: 1px solid var(--border, #ddd);
            border-radius: 6px;
            max-height: 220px;
            overflow-y: auto;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }
        .searchable-result-item {
            padding: 8px 10px;
            cursor: pointer;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border, #eee);
        }
        .searchable-result-item:hover {
            background: var(--table-header, #f0f0f0);
        }
        .searchable-result-item.muted {
            color: #888;
            cursor: default;
        }
        .searchable-result-item.clear-link {
            color: #c0392b;
        }
    </style>
</body>
</html>
