    <div id="visitors" class="tab-content">
        <h3>سجل زوار الموقع (آخر 200 زيارة)</h3>
        <div class="table-container" style="overflow-x: auto;">
            <table class="table-fit" style="width: 100%; min-width: 600px;">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>التاريخ</th>
                        <th>الاسم</th>
