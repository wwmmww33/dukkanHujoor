<main class="main-content">
        <div class="auth-container fade-in">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">🔑 تسجيل الدخول</h1>
            <p class="auth-subtitle">مرحباً بعودتك إلى دكان الحجور</p>
        </div>
        
        <% if (error) { %>
            <div class="alert alert-error">
                <i class="error-icon">⚠️</i>
                <%= error %>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        
        <form method="POST" action="/login" class="auth-form">
            <div class="form-group">
                <label for="phone" class="form-label">📱 رقم الهاتف أو البريد الإلكتروني</label>
                <input type="text" id="phone" name="phone" required
                       class="form-input"
                       placeholder="99123456 أو example@email.com"
                       autocomplete="username">
            </div>
            
            <div class="form-group">
                <label for="password" class="form-label">🔒 كلمة المرور</label>
                <input type="password" id="password" name="password" required 
                       class="form-input"
                      placeholder="أدخل كلمة المرور"
                      autocomplete="current-password">
            </div>
            
          <button type="submit" class="submit-btn">تسجيل الدخول</button>
        </form>
        
        <div class="auth-footer">
            <p>ليس لديك حساب؟ <a href="/register" class="auth-link">إنشاء حساب جديد</a></p>
            <p><a href="/forgot-password" class="auth-link">هل نسيت كلمة المرور؟</a></p>

        </div>
        

    </div>
</div>


        </div>
    </main>